# Скопируйте в `.env` рядом с проектом и заполните своими значениями.
# Обязательные: TELEGRAM_BOT_TOKEN, ALLOWED_USER_IDS; MODEL_API_KEY — при
# MODEL_BACKEND=openai, DSH_COMMAND — при MODEL_BACKEND=dsh.

# --- Telegram ---
# Токен от @BotFather: /newbot -> «<цифры>:<секрет>»
TELEGRAM_BOT_TOKEN=
# Корень Bot API; меняйте только для локального прокси или зеркала.
TELEGRAM_API_BASE=https://api.telegram.org
# Кто может пользоваться ботом: ваши Telegram user id через запятую.
# Свой id покажет команда /whoami после запуска, либо @userinfobot.
ALLOWED_USER_IDS=
# true — пускать всех (не рекомендуется: чужие тратят ваши деньги).
ALLOW_ALL_USERS=false
# Типы чатов, в которых бот вообще работает.
ALLOWED_CHAT_TYPES=private,group,supergroup
# Что ответить постороннему; {id} подставляется автоматически.
DENY_MESSAGE=Доступ закрыт. Ваш Telegram ID: {id}. Передайте его владельцу бота.

# --- Модель (любой OpenAI-совместимый API) ---
# openai — HTTP-API провайдера (нужен MODEL_API_KEY), dsh — локальный DSH CLI.
MODEL_BACKEND=openai
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
# Только при MODEL_BACKEND=dsh: путь к исполняемому файлу dsh (обязателен).
DSH_COMMAND=
DSH_PROFILE=headless
DSH_HOME=
# Необязательные параметры генерации.
MODEL_TEMPERATURE=
MODEL_MAX_TOKENS=
SYSTEM_PROMPT=Ты полезный ассистент в мессенджере. Отвечай по существу, на языке собеседника, без лишних преамбул. У тебя есть инструменты: weather (погода и прогноз по городу), web_search (свежие новости, курсы, цены, события), web_fetch (прочитать страницу), remind (напоминания), remember (запомнить факт о пользователе). Для любых вопросов о погоде всегда вызывай weather, а не web_search и не отвечай по памяти. Для остальных свежих данных вызывай web_search. Никогда не отвечай, что у тебя нет доступа к интернету: вызови инструмент. Когда пользователь просит напомнить — обязательно вызови remind и возьми время из системного сообщения о текущем моменте. Никогда не пиши, что напоминание создано, если инструмент remind не был вызван. Когда пользователь сообщает о себе что-то долговечное (имя, город, профессия, предпочтения) — вызови remember, а если он назвал свой город, обязательно передай его в параметре city. Если пользователь спрашивает про погоду без города, а известно, что он живёт в каком-то городе, вызывай weather без city. В групповом чате ты видишь только имена участников: личные факты и город собеседника там недоступны, поэтому про личное вежливо предложи написать в личные сообщения. Если инструмент вернул ошибку, скажи об этом прямо и не выдумывай данные. Коротко указывай источник и время наблюдения.

# --- Интернет: web_search, web_fetch и weather ---
# Инструменты выдаются модели только при MODEL_BACKEND=openai.
WEB_TOOLS=true

# --- Мост к агенту-исполнителю на отдельном сервере ---
# Приватная группа, в которой состоят оба бота. Пусто — мост выключен и поведение
# бота не меняется. Задачи уходят в группу упоминанием, агент отвечает там же и
# присылает результат владельцу отдельным сообщением.
AGENT_BRIDGE_GROUP_ID=
AGENT_BRIDGE_USERNAME=@Tenkrol_ag_bot
# Контракт v2 (PLB-009): события, файлы и вопросы; v1 — прежний /bridge.
AGENT_CONTRACT=
AGENT_FILES_MAX_BYTES=
AGENT_EVENTS_RETENTION_DAYS=
AGENT_ANSWER_TIMEOUT_MS=
# Погода — отдельный инструмент weather: Open-Meteo (геокодинг + прогноз, ключ не
# нужен), резерв — wttr.in. Для вопросов о погоде модель вызывает weather, а не
# web_search: поиск отдаёт закешированные страницы с прогнозом на неверный день.
# Сколько поисков разрешено внутри одного вызова web_search.
WEB_SEARCH_MAX_USES=3
# Сколько байт страницы прочитать, после чего загрузка обрывается.
WEB_FETCH_MAX_BYTES=200000
# Anthropic-совместимый корень серверного поиска DeepSeek; добавляется /messages.
SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# Модель, выполняющая серверный поиск.
SEARCH_MODEL=deepseek-v4-flash
# Сколько раундов вызова инструментов допускается на один ответ.
MAX_TOOL_ROUNDS=4
# Через запятую: хосты, которым разрешено обращаться к приватным адресам —
# например внутренняя wiki. Остальные приватные адреса web_fetch отклоняет.
WEB_FETCH_ALLOWED_HOSTS=

# --- Напоминания ---
# true — модель получает инструмент remind, работают /reminders и /cancel.
# false — напоминания полностью выключены (файл reminders.json не читается).
REMINDERS=true
# Напоминания принадлежат пользователю, а не чату: в группе каждый видит и
# отменяет только свои (/reminders, /cancel), а сработавшее напоминание
# подписано владельцем. Старые записи без владельца считаются общими для чата.
# Как часто планировщик проверяет наступивший срок, секунды (5–600).
REMINDER_CHECK_SEC=20

# --- Память о пользователе ---
# true — модель получает инструмент remember, работают /city, /memory и /forget,
# а погода без названного города берёт сохранённый город по умолчанию.
# false — память профиля выключена целиком (файл users.json не читается).
MEMORY=true
# Профиль привязан к id пользователя (город, факты, публичное имя Telegram),
# поэтому работает и в личке, и в группе. В группе модели передаются только имена
# участников, без города и фактов; личный контекст — только в личке.
# Сколько профилей пользователей хранить (факты + город по умолчанию); при
# переполнении вытесняются профили, которые дольше всех не обновлялись.
MAX_USERS=1000

# --- Утренний дайджест ---
# true — раз в сутки бот сам присылает сводку (погода, праздники, напоминания
# на сегодня, анекдот дня и необязательные темы); команда /digest присылает её
# же по запросу.
DIGEST=true
# Время отправки по локальным часам зоны TIME_ZONE, формат HH:MM (00:00–23:59).
# Значение вне этого шаблона молча откатывается к 08:00 — в логе видно
# digest scheduled {at, chats, topics}.
DIGEST_TIME=08:00
# Темы необязательного блока («в мире»): поисковые запросы через запятую, не
# больше трёх. Запятая и пробел разделяют одинаково, поэтому тема — одно слово.
# Блок появляется только при MODEL_BACKEND=openai и WEB_TOOLS=true.
DIGEST_TOPICS=
# Общая сводка новостей в дайджесте; по умолчанию выключена (false), поэтому
# блок «Новости» не добавляется и поиск по нему не выполняется.
DIGEST_NEWS=false
# Добавлять в дайджест анекдот дня.
DIGEST_JOKE=true
# Код страны из двух букв для блока праздников (Nager.Date), по умолчанию RU.
DIGEST_COUNTRY=RU
# Кому отправлять дайджест; пусто — всем из ALLOWED_USER_IDS. При
# ALLOW_ALL_USERS=true и пустом списке отправлять некому: в лог попадёт
# предупреждение «digest enabled but there is nobody to send it to».
DIGEST_CHAT_IDS=

# --- Полезная проактивность (BP-04) ---
# true — инициативные уведомления и утренний обзор идут через один планировщик
# (таймер напоминаний), с тихими часами, дневным пределом и кнопками.
# false — dry-run: решения считаются и пишутся в журнал proactive.json, но
# ничего не отправляется. Это значение по умолчанию.
PROACTIVE_ENABLED=false
# Время обзора по локальным часам зоны TIME_ZONE, формат HH:MM.
PROACTIVE_REVIEW_AT=09:00
# Сколько инициативных уведомлений в день; обзор считается отдельно (1 в день).
PROACTIVE_DAY_LIMIT=3
# Как часто пересчитывать план, секунды (10–3600). Второго таймера нет:
# проверка идёт внутри тика напоминаний.
PROACTIVE_CHECK_SEC=60

# --- Расход токенов и дневной лимит ---
# Дневной бюджет в токенах (prompt + completion; кешированные не считаются):
# 0 — без лимита. Когда бюджет исчерпан, бот отказывается отвечать до полуночи
# по TIME_ZONE; текущие числа и процент показывает /stats.
DAILY_TOKEN_LIMIT=0
# Сколько дней хранить DATA_DIR/usage.json (1–3650).
USAGE_RETENTION_DAYS=60

# --- Поведение ---
# Сколько сообщений диалога держать в контексте (одно сообщение = реплика).
HISTORY_LIMIT=20
# Сколько чатов держать в памяти (лишние вытесняются LRU).
MAX_CHATS=1000
# Сколько ответов модели обрабатывать одновременно.
MAX_CONCURRENT_REQUESTS=4
# Повторы getMe при сетевом сбое на старте.
STARTUP_ATTEMPTS=3
# Сколько ждать завершения активных ответов при остановке, миллисекунды.
SHUTDOWN_GRACE_MS=5000
# Строка heartbeat в логе раз в N минут (0–1440); 0 — выключено.
# Для работы 24/7 поставьте 60: раз в час в лог пишется
# heartbeat {uptimeSec, chats, reminders, inFlight} — по нему видно, что
# процесс жив; отдельного HTTP-эндпоинта для проверки не нужно.
# Внешний сторож (tools/watchdog.mjs) читает это значение из .env на Mac:
# при 0 он пропускает проверку свежести журнала, иначе ждёт записи не старше
# 95 минут (порог STALE_MINUTES).
HEARTBEAT_MINUTES=60
# Длительность long-poll запроса к Telegram, секунды.
POLL_TIMEOUT_SEC=30
# Тайм-ауты HTTP, миллисекунды.
TELEGRAM_TIMEOUT_MS=60000
MODEL_TIMEOUT_MS=180000
# Часовой пояс для даты и времени, которые бот добавляет в запрос к модели
# (значение уходит в Intl). Пусто — системная зона; значение формата Europe/Moscow.
TIME_ZONE=

# --- Прочее ---
# Какой файл читать вместо .env; значение берётся из реального окружения
# (из самого .env эта переменная не читается).
# DOTENV_FILE=.env
# Каталог состояния: история диалогов, позиция опроса, напоминания, профили
# пользователей и счётчики расхода.
DATA_DIR=./data
# debug | info | warn | error
LOG_LEVEL=info

# --- Прокси (если api.telegram.org недоступен напрямую) ---
# Node начнёт использовать эти переменные только с флагом --use-env-proxy
# или с NODE_USE_ENV_PROXY=1 (Node 24+). При старте бот предупредит об этом.
# HTTPS_PROXY=http://user:pass@proxy.example:3128
# NODE_USE_ENV_PROXY=1

# --- Платформа ---
# Какой мессенджер обслуживает этот процесс: telegram или max.
# В .env его лучше не задавать: сервисы tg-agent и max-agent передают PLATFORM
# сами, а systemd применяет .env ПОСЛЕ Environment= — строка отсюда перекрыла бы
# выбор юнита.
# PLATFORM=telegram

# --- MAX (max.ru) ---
# Токен бота из «MAX для бизнеса»: business.max.ru → Чат-боты → Настройки → токен.
# Пока токен пуст, сервис max-agent не запускается.
MAX_TOKEN=
# Адрес API MAX. platform-api2.max.ru — рекомендованный домен.
MAX_API_BASE=https://platform-api2.max.ru
MAX_TIMEOUT_MS=60000
MAX_POLL_TIMEOUT_SEC=30
# Ограничения MAX: не больше двух сообщений в секунду в один чат (адаптер
# сериализует отправки) и не больше 4000 символов в сообщении (адаптер разбивает
# длинный ответ). Один токен — один поллер: второй экземпляр бота с тем же
# MAX_TOKEN не запускайте.
# Long polling MAX считает способом для разработки: для production платформа
# рекомендует Webhook, а ему нужен публичный HTTPS-адрес.
# Даже при PLATFORM=max ядро по-прежнему требует TELEGRAM_BOT_TOKEN — он остаётся
# в списке обязательных переменных.
# Сертификат API MAX подписан корневым сертификатом Минцифры. На сервере он
# должен быть в доверенных, иначе будет ошибка TLS:
#   curl -fsS -o /usr/local/share/ca-certificates/russian_trusted_root_ca.crt https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
#   curl -fsS -o /usr/local/share/ca-certificates/russian_trusted_sub_ca.crt https://gu-st.ru/content/Other/doc/russiantrustedca.pem
#   update-ca-certificates


# Реакции на ваши сообщения (👀 получил, 👍 ответил). false = не ставить
REACTIONS=false

STREAM=true
STREAM_THROTTLE_MS=900

# VK Teams (альтернативная платформа): PLATFORM=vk-teams
VK_TEAMS_TOKEN=
VK_TEAMS_API_BASE=https://myteam.mail.ru/bot/v1

# VK (VKontakte), альтернативная платформа: PLATFORM=vk
VK_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199

# Раздельные списки доступа по платформам (пусто = только общий ALLOWED_USER_IDS)
ALLOWED_USER_IDS_VK=
ALLOWED_USER_IDS_TELEGRAM=

# Озвучка ответов (команда /voice вкл в чате). Ключ можно не задавать — берётся STT_API_KEY.
TTS_PROVIDER=none   # none | yandex
TTS_API_KEY=
TTS_VOICE=alena     # alena, filipp, jane, zahar, ermil, madirus…
TTS_SPEED=1.0
TTS_MAX_CHARS=1200

# --- Мобильный сайт `/mobile/`: вход по паролю ---
# Логин и пароль. Пароль хранится только scrypt-хешем (не открытым текстом). Хеш и секрет сессии
# выдаёт tools/mobile-password.mjs; вывод сохраните в менеджере паролей и в .env.
# Без обоих значений сайт открывается, но данные требуют Telegram.
MOBILE_USERNAME=   # стартовый логин владельца; дальше меняется в настройках сайта
MOBILE_PASSWORD_HASH=
MOBILE_SESSION_SECRET=
# Чьи данные показывает сайт: Telegram user id из ALLOWED_USER_IDS.
# Пусто — первый id из ALLOWED_USER_IDS.
MOBILE_USER_ID=
MOBILE_USER_NAME=Владелец
# Срок сессии в секундах (по умолчанию неделя).
MOBILE_SESSION_TTL_SEC=604800
# Cookie Secure: true на HTTPS, false только для локальной проверки по http.
MOBILE_COOKIE_SECURE=true
# Куда ведёт кнопка «Продолжить в Telegram».
MOBILE_TELEGRAM_URL=https://t.me/Tenkrol_bot
